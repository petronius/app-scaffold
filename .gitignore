# macOS
.DS_Store

# Generated by XcodeGen (run `xcodegen generate` after cloning)
Scaffold.xcodeproj/
# xcodegen writes these from project.yml on every generate
App/Info.plist
App/*.entitlements
Widget/Info.plist
Widget/*.entitlements
WatchApp/Info.plist
WatchApp/*.entitlements
WatchWidget/Info.plist
WatchWidget/*.entitlements

# Xcode user state
xcuserdata/
*.xcuserstate
*.xcscmblueprint

# Build products
build/
DerivedData/
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
.swiftpm/

# Local editor and agent state
*.swp
.claude/

# bgbuild agent artifacts (reports, scratch assets); code never reads _resources/
.taskbot/_resources/

# App Store Connect credentials: never in the repository
*.p8
*.env
